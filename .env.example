# ─────────────────────────────────────────────────────────────────
#  BBC College AI Chatbot — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── OpenAI API (required for LLM Layer 3)
# Get your key at: https://platform.openai.com/api-keys
# If left blank the chatbot still works via Rule + Semantic layers.
OPENAI_API_KEY=your_openai_api_key_here

# ── Flask secret key (REQUIRED — change before deploying)
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-before-deploying

# ── SQLite database file path
# Relative path → stored in the project root folder.
# For production on Render/Railway use a persistent-disk mount path.
# Example for Render:  /var/data/college.db
DATABASE_PATH=college.db

# ── Flask environment
# Use "development" locally (enables the Werkzeug debugger).
# Use "production" on any live server.
FLASK_ENV=production
FLASK_DEBUG=0

# ── Optional: sentence-transformers model name
# Default is all-MiniLM-L6-v2 (fast, 80 MB).
# Alternatives: all-mpnet-base-v2 (more accurate, 420 MB)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Optional: override the OpenAI model used for Layer 3
# Default is gpt-3.5-turbo (fast + cheap).
# Use gpt-4o for higher quality at higher cost.
# OPENAI_MODEL=gpt-3.5-turbo

# ── Optional: similarity threshold for semantic search (0.0 – 1.0)
# Lower = more permissive matches.  Higher = stricter.
# SIMILARITY_THRESHOLD=0.55

